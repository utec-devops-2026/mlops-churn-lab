{
  "title": "Churn Predictor · Monitoring",
  "uid": "churn-monitoring",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API: requests/seg por status",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"fastapi\"}[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "API: latencia p95 (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"fastapi\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Predicciones por nivel de riesgo (por seg)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (risk_level) (rate(churn_predictions_total[1m]))",
          "legendFormat": "{{risk_level}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Probabilidad de churn promedio servida",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(churn_probability_sum[5m]) / rate(churn_probability_count[5m])",
          "legendFormat": "probabilidad media",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Semana simulada",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "model_simulated_week",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Features con drift crítico",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "model_drifted_features",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "PSI máximo",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "model_psi_max",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "¿Reentrenar?",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "model_retrain_needed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Modelo: F1 y recall (con etiquetas)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "model_f1",
          "legendFormat": "F1",
          "refId": "A"
        },
        {
          "expr": "model_recall",
          "legendFormat": "recall",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Drift: PSI por feature y PSI de predicción",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "{__name__=~\"model_psi_.+\", __name__!=\"model_psi_max\"}",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        },
        {
          "expr": "model_prediction_psi",
          "legendFormat": "prediction_psi",
          "refId": "B"
        }
      ]
    }
  ]
}